<resources>
    <style name="Theme.VNTRemote" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/vnt_brand</item>
        <item name="colorPrimaryVariant">@color/vnt_brand_hover</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/vnt_brand</item>
        <item name="android:colorBackground">@color/vnt_bg</item>
        <item name="colorSurface">@color/vnt_surface</item>
        <item name="colorOnSurface">@color/vnt_text</item>
        <item name="colorOnBackground">@color/vnt_text</item>
        <item name="android:textColorPrimary">@color/vnt_text</item>
        <item name="android:textColorSecondary">@color/vnt_text_2</item>
        <item name="colorControlNormal">@color/vnt_text_2</item>
        <item name="android:windowLightStatusBar">@bool/vnt_light_system_bars</item>
        <item name="android:statusBarColor">@color/vnt_surface</item>
        <item name="android:navigationBarColor">@color/vnt_bg</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="materialButtonStyle">@style/Widget.VNTRemote.Button</item>
        <item name="textInputStyle">@style/Widget.VNTRemote.TextInput</item>
    </style>
    <style name="Widget.VNTRemote.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">9dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Widget.VNTRemote.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/vnt_surface</item>
        <item name="boxStrokeColor">@color/vnt_border_strong</item>
        <item name="boxCornerRadiusTopStart">9dp</item>
        <item name="boxCornerRadiusTopEnd">9dp</item>
        <item name="boxCornerRadiusBottomStart">9dp</item>
        <item name="boxCornerRadiusBottomEnd">9dp</item>
        <item name="hintTextColor">@color/vnt_brand</item>
    </style>
    <style name="ThemeOverlay.VNTRemote.Remote" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorPrimary">#5D7CFF</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorOnSurface">#E8EBF2</item>
        <item name="android:textColorPrimary">#E8EBF2</item>
        <item name="android:textColorSecondary">#A2ABBD</item>
    </style>
</resources>
